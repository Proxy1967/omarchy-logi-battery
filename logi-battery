#!/usr/bin/python3
"""Read a wireless mouse's battery, preferring a real percentage.

Two sources, in order of what they can tell us:

1. HID++ (Logitech wireless devices). The kernel's hid-logitech-hidpp reads a
   numeric charge from the device but only publishes it as a `capacity` file
   when the device advertises a capability flag many mice don't set — so the
   number is there but sysfs won't show it. Ask the device directly instead,
   trying each of the three battery features Logitech has shipped.
2. sysfs `capacity`, for anything else that already reports a real percentage
   (Bluetooth mice via the HID battery service, other vendors' drivers).

`capacity_level` is the fallback when neither yields a number: a coarse
Full/High/Normal/Low/Critical with no percentage behind it.

Prints one tab-separated line — model, percent (may be empty), level (may be
empty) — for the best candidate found, or nothing when there is none. An
optional argument filters devices by a case-insensitive substring of the name,
for when more than one mouse is connected.
"""

import glob
import os
import random
import select
import sys
import time

# HID++ tags every reply with the software id of the request that caused it.
# Pick one per process: a bar surface exists per monitor, so two copies of this
# reader run at once, and every open of a hidraw node receives a copy of every
# reply — including the other copy's. A shared id makes those indistinguishable.
SW_ID = random.randint(1, 15)
ROOT_INDEX = 0x00     # the ROOT feature is always at index 0

UNIFIED_BATTERY = 0x1004    # newer devices; carries a state-of-charge byte
BATTERY_STATUS = 0x1000     # older devices; carries a discharge level
BATTERY_VOLTAGE = 0x1001    # rechargeables; millivolts, needs a curve

# An idle mouse ignores requests until the radio link wakes, and that applies
# to the battery read itself, not just the first lookup — a lone timeout means
# nothing. Only the feature lookups of an already-woken device get the short
# count, since by then a silent device is a device that hasn't got the feature.
ATTEMPT_TIMEOUT = 0.5
WAKE_ATTEMPTS = 5
AWAKE_ATTEMPTS = 2

# Li-ion discharge curve, lifted from solaar's hidpp20.py. Only meaningful for
# the rechargeable devices that expose BATTERY_VOLTAGE in the first place.
VOLTAGE_CURVE = [
    (4186, 100), (4067, 90), (3989, 80), (3922, 70), (3859, 60),
    (3811, 50), (3778, 40), (3751, 30), (3717, 20), (3671, 10),
    (3610, 5), (3579, 2), (3500, 0),
]

# UNIFIED_BATTERY reports its coarse level as a bitmask.
UNIFIED_LEVELS = {8: "Full", 4: "High", 2: "Low", 1: "Critical"}


def hidpp_request(fd, dev_index, feat_index, func, params=b"", attempts=AWAKE_ATTEMPTS):
    """Send a short HID++ request, returning the matching reply or None."""
    tag = (func << 4) | SW_ID
    packet = bytes([0x10, dev_index, feat_index, tag]) + params.ljust(3, b"\x00")

    for _ in range(attempts):
        os.write(fd, packet)
        # This node also carries the kernel driver's own requests and the
        # device's notifications. Those are not ours — the software id in the
        # tag byte is what tells them apart — so keep draining until this
        # attempt's window is out rather than retrying on the first stranger.
        deadline = time.monotonic() + ATTEMPT_TIMEOUT
        while True:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                break
            ready, _, _ = select.select([fd], [], [], remaining)
            if not ready:
                break
            reply = os.read(fd, 64)
            # An error reply carries feature index 0xFF (HID++ 2.0) or 0x8F
            # (HID++ 1.0), so it won't match and the request simply times out.
            if len(reply) >= 7 and reply[0] in (0x10, 0x11) \
                    and reply[1] == dev_index \
                    and reply[2] == feat_index and reply[3] == tag:
                return reply
    return None


def feature_index(fd, dev_index, feature, attempts):
    """Where this device keeps `feature`, or None if it doesn't have it."""
    reply = hidpp_request(
        fd, dev_index, ROOT_INDEX, 0,
        bytes([feature >> 8, feature & 0xFF]), attempts,
    )
    if reply is None:
        return None      # device unreachable — asleep, off, out of range
    return reply[4] or 0  # index 0 means "no such feature here"


def voltage_percent(millivolts):
    for threshold, percent in VOLTAGE_CURVE:
        if millivolts >= threshold:
            return percent
    return 0


def read_hidpp(path, dev_index):
    """(percent, level) from the device itself, or None if it never answered."""
    try:
        fd = os.open(path, os.O_RDWR | os.O_NONBLOCK)
    except OSError:
        return None  # no udev ACL for us, or the device just went away
    try:
        # The first lookup carries the wake-up retries for the whole exchange.
        attempts = WAKE_ATTEMPTS
        for feature in (UNIFIED_BATTERY, BATTERY_STATUS, BATTERY_VOLTAGE):
            index = feature_index(fd, dev_index, feature, attempts)
            if index is None:
                return None
            attempts = AWAKE_ATTEMPTS
            if not index:
                continue

            if feature is UNIFIED_BATTERY:
                reply = hidpp_request(fd, dev_index, index, 1, attempts=WAKE_ATTEMPTS)
                if reply:
                    # A zero state-of-charge means this device only fills in
                    # the coarse level beside it.
                    return (reply[4] or None, UNIFIED_LEVELS.get(reply[5], ""))
            elif feature is BATTERY_STATUS:
                reply = hidpp_request(fd, dev_index, index, 0, attempts=WAKE_ATTEMPTS)
                if reply:
                    return (reply[4], "")
            else:
                reply = hidpp_request(fd, dev_index, index, 0, attempts=WAKE_ATTEMPTS)
                if reply:
                    return (voltage_percent((reply[4] << 8) | reply[5]), "")
        return (None, "")
    finally:
        os.close(fd)


def pairing_index(phys):
    """The receiver slot to address a device by, or 0xFF for a direct link.

    hid-logitech-dj builds a paired device's phys as "<receiver>/input2:1", so
    the slot follows the last colon of the last path segment. A device on USB
    or Bluetooth has no slot and answers on 0xFF — and a Bluetooth phys is a
    bare MAC, whose final octet is all digits often enough (roughly two MACs in
    five) that reading it as a slot would address nothing.
    """
    if "/" not in phys:
        return 0xFF
    last = phys.rsplit("/", 1)[-1]
    if ":" not in last:
        return 0xFF
    tail = last.rsplit(":", 1)[-1]
    return int(tail) if tail.isdigit() else 0xFF


def read_attr(directory, name):
    try:
        with open(os.path.join(directory, name)) as f:
            return f.read().strip()
    except OSError:
        return ""


def is_mouse(device_dir):
    """The kernel builds a mouseN node for anything it treats as a mouse."""
    return bool(glob.glob(os.path.join(device_dir, "input/*/mouse*")))


def level_beside(device_dir):
    """The coarse level this device's own power supply publishes, if any."""
    for supply in sorted(glob.glob(os.path.join(device_dir, "power_supply/*"))):
        level = read_attr(supply, "capacity_level")
        if level:
            return level
    return ""


def wanted_mouse(name, device_dir, wanted):
    """Skip anything we would not report on — before going near its radio."""
    if wanted and wanted not in name.lower():
        return False
    return is_mouse(device_dir)


def hidpp_candidates(wanted):
    """Every Logitech HID++ mouse, read from the device itself."""
    for node in sorted(glob.glob("/sys/class/hidraw/hidraw*")):
        device_dir = os.path.join(node, "device")
        uevent = read_attr(device_dir, "uevent")
        fields = dict(l.split("=", 1) for l in uevent.splitlines() if "=" in l)
        if fields.get("DRIVER") != "logitech-hidpp-device":
            continue

        name = fields.get("HID_NAME", "Logitech device")
        if not wanted_mouse(name, device_dir, wanted):
            continue

        reading = read_hidpp(
            "/dev/" + os.path.basename(node),
            pairing_index(fields.get("HID_PHYS", "")),
        )
        percent, level = reading if reading else (None, "")
        yield {
            "name": name,
            "percent": percent,
            "level": level or level_beside(device_dir),
        }


def sysfs_candidates(wanted):
    """Mouse batteries the kernel already publishes."""
    for supply in sorted(glob.glob("/sys/class/power_supply/*")):
        if read_attr(supply, "scope") != "Device":
            continue
        name = read_attr(supply, "model_name") or os.path.basename(supply)
        if not wanted_mouse(name, os.path.join(supply, "device"), wanted):
            continue
        capacity = read_attr(supply, "capacity")
        yield {
            "name": name,
            "percent": int(capacity) if capacity.isdigit() else None,
            "level": read_attr(supply, "capacity_level"),
        }


def main():
    wanted = sys.argv[1].lower() if len(sys.argv) > 1 else ""

    found = [c for c in list(hidpp_candidates(wanted)) + list(sysfs_candidates(wanted))
             if c["percent"] is not None or c["level"]]
    if not found:
        return

    # A real percentage beats a coarse level, which is what makes the HID++
    # reading win over the same device's sysfs entry, and what lets that entry
    # stand in when the mouse is asleep.
    best = max(found, key=lambda c: c["percent"] is not None)
    sys.stdout.write("%s\t%s\t%s" % (
        best["name"],
        "" if best["percent"] is None else best["percent"],
        best["level"],
    ))


main()
